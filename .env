# Postgres connection string (Railway/Render give you this automatically)
DATABASE_URL=postgres://user:password@host:5432/vantrack

# Secret used to sign login tokens - make this a long random string
JWT_SECRET=change-this-to-a-long-random-string

# Server port
PORT=3000

# --- SMS (MSG91) ---
# Sign up at https://msg91.com, verify your business, buy SMS credits,
# and create a Sender ID + template to get these values.
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=VNTRCK
MSG91_TEMPLATE_ID=your-dlt-approved-template-id

# How many days before expiry to send the first reminder
REMINDER_DAYS_BEFORE=3
